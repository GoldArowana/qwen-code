+        assertThat(receipt).isEqualTo(JSON.createObjectNode().put("resourceId", receipt.path("resourceId").asText())
+                .put("kind", kind).put("schemaVersion", 1).put("byteLength", length)
+                .put("digest", ToolPublicationContract.sha256(bytes)));
