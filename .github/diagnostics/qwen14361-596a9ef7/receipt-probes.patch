+    @Test
+    void sealAndPageKeepTheirOwnReceiptShapes() {
+        byte[] bytes = "page-bytes".getBytes(StandardCharsets.UTF_8);
+        String digest = ToolPublicationContract.sha256(bytes);
+        assertThat(publish("page-segment", 0, "page-bytes").path("state").asText()).isEqualTo("PENDING");
+        assertThat(data.verifyNextOperation()).isTrue();
+        assertThat(data.seal(key, "pub-1", PUBLICATION_TOKEN, "page-seal", "stdout", 1, bytes.length, digest)
+                .path("state").asText()).isEqualTo("PENDING");
+        assertThat(data.verifyNextOperation()).isTrue();
+        assertThat(status("page-seal").path("receipt")).isEqualTo(
+                JSON.createObjectNode().put("segmentCount", 1).put("byteLength", bytes.length).put("digest", digest));
+        ObjectNode page = JSON.createObjectNode().put("toolResult", "managed-tool-result/1")
+                .put("type", "page").put("captureId", "capture-1").put("streamId", "stdout")
+                .put("firstOrdinal", 0).put("offset", 0);
+        page.putArray("segments").add(JSON.createObjectNode().put("byteLength", bytes.length).put("digest", digest));
+        byte[] pageBytes = page.toString().getBytes(StandardCharsets.UTF_8);
+        String pageKind = "managed-tool-result-page";
+        assertThat(data.publishResource(key, "pub-1", PUBLICATION_TOKEN, "page", "page:stdout:0", pageKind, pageBytes)
+                .path("state").asText()).isEqualTo("PENDING");
+        assertThat(data.verifyNextOperation()).isTrue();
+        JsonNode receipt = status("page").path("receipt");
+        assertThat(receipt.path("resourceId").asText()).startsWith("result-");
+        assertThat(receipt).isEqualTo(JSON.createObjectNode().put("resourceId", receipt.path("resourceId").asText())
+                .put("kind", pageKind).put("schemaVersion", 1).put("byteLength", pageBytes.length)
+                .put("digest", ToolPublicationContract.sha256(pageBytes)));
+    }
+
+    private JsonNode segmentReceipt(String stream, byte[] bytes) {
+        return JSON.createObjectNode().put("captureId", fixture.binding.path("captureId").asText())
+                .put("streamId", stream).put("ordinal", 0).put("byteLength", bytes.length)
+                .put("digest", ToolPublicationContract.sha256(bytes));
+    }
