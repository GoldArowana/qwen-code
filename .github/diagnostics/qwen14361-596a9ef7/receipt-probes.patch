+    @ParameterizedTest
+    @ValueSource(strings = {"stdout", "stderr"})
+    void asyncSegmentReceiptNamesTheOriginalCaptureStreamAndOrdinal(String stream) {
+        byte[] bytes = (stream + "-receipt").getBytes(StandardCharsets.UTF_8);
+        String digest = ToolPublicationContract.sha256(bytes);
+        assertThat(data.publishSegment(key, "pub-1", PUBLICATION_TOKEN, "observed", stream, 0, bytes, digest)
+                .path("state").asText()).isEqualTo("PENDING");
+        data = replacement();
+        assertThat(data.verifyNextOperation()).isTrue();
+        JsonNode current = status("observed");
+        assertThat(current.path("state").asText()).isEqualTo("SUCCEEDED");
+        int reads = bucket.opens.get();
+        assertThat(data.publishSegment(key, "pub-1", PUBLICATION_TOKEN, "observed", stream, 0, bytes, digest))
+                .isEqualTo(current);
+        JsonNode alias = data.publishSegment(key, "pub-1", PUBLICATION_TOKEN, "alternate", stream, 0, bytes, digest);
+        assertThat(alias.path("state").asText()).isEqualTo("SUCCEEDED");
+        JsonNode expected = segmentReceipt(stream, bytes);
+        assertThat(alias.path("receipt")).isEqualTo(expected);
+        assertThat(bucket.opens).hasValue(reads);
+        assertThat(current.path("receipt")).isEqualTo(expected);
+    }
