+    @Test
+    void seededLegacySucceededReceiptSurvivesReplacementAndOriginalReplay() {
+        byte[] bytes = "legacy-receipt".getBytes(StandardCharsets.UTF_8);
+        String digest = ToolPublicationContract.sha256(bytes);
+        assertThat(publish("legacy", 0, "legacy-receipt").path("state").asText()).isEqualTo("PENDING");
+        assertThat(data.verifyNextOperation()).isTrue();
+        String slot = "segment:stdout:0";
+        String resource = fixture.jdbc.queryForObject("SELECT resource_id FROM ma_resource WHERE slot_key = ?",
+                String.class, slot);
+        String kind = fixture.jdbc.queryForObject("SELECT kind FROM ma_resource WHERE slot_key = ?", String.class, slot);
+        assertThat(kind).isEqualTo("managed-tool-segment");
+        assertThat(resource).startsWith("capture-segment-");
+        JsonNode legacy = JSON.createObjectNode().put("resourceId", resource).put("kind", kind)
+                .put("schemaVersion", 1).put("byteLength", bytes.length).put("digest", digest);
+        assertThat(fixture.jdbc.update("UPDATE ma_operation SET result_json = ? "
+                + "WHERE operation_id = X'6c6567616379' AND state = 'SUCCEEDED'", legacy.toString())).isEqualTo(1);
+        data = replacement();
+        int reads = bucket.opens.get();
+        JsonNode current = status("legacy");
+        assertThat(current.path("state").asText()).isEqualTo("SUCCEEDED");
+        assertThat(current.path("receipt")).isEqualTo(legacy);
+        assertThat(publish("legacy", 0, "legacy-receipt")).isEqualTo(current);
+        assertThat(publish("legacy-alias", 0, "legacy-receipt").path("receipt"))
+                .isEqualTo(segmentReceipt("stdout", bytes));
+        assertThatThrownBy(() -> status("legacy-alias"))
+                .isInstanceOf(ManagedAgentException.class).hasMessageContaining("operation is unknown");
+        assertThatThrownBy(() -> publish("legacy", 0, "changed")).hasMessageContaining("operation conflicts");
+        assertThatThrownBy(() -> publish("wrong-alias", 0, "changed")).hasMessageContaining("slot conflicts");
+        assertThat(bucket.opens).hasValue(reads);
+    }
